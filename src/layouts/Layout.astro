---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "Quentin DUROY · Référent IA & Chef de projet Web | Provence",
  description = "Référent IA à l'Office de Tourisme de Manosque, fondateur de LOGIQ IA. Make.com, agents IA, MCP, automatisation. Basé à Gréoux-les-Bains, intervient partout en France.",
  canonical = "https://quentin-duroy.fr/",
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth bg-[--color-bg]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Quentin DUROY",
        url: "https://quentin-duroy.fr",
        image: "https://quentin-duroy.fr/quentin.jpg",
        jobTitle:
          "Référent IA & Chef de Projet Web · Fondateur LOGIQ IA",
        description:
          "Chef de projet IA basé en Provence. Fondateur de LOGIQ IA, Référent IA à l'Office de Tourisme du Pays de Manosque. Spécialiste Make.com, agents IA, automatisation des workflows.",
        worksFor: [
          {
            "@type": "Organization",
            name: "LOGIQ IA",
            url: "https://logiq-ia.fr",
          },
          {
            "@type": "Organization",
            name: "Office de Tourisme et des Congrès du Pays de Manosque",
          },
        ],
        alumniOf: [
          {
            "@type": "EducationalOrganization",
            name: "SUPDEWEB",
          },
          {
            "@type": "EducationalOrganization",
            name: "Aix-Marseille Université",
          },
        ],
        knowsAbout: [
          "Intelligence artificielle",
          "Automatisation des processus",
          "Make.com",
          "Agents IA",
          "MCP",
          "Gestion de projet web",
          "SEO",
          "Anthropic Claude",
        ],
        hasCredential: [
          {
            "@type": "EducationalOccupationalCredential",
            name: "AI Fluency Framework & Foundations",
            credentialCategory: "certification",
            recognizedBy: { "@type": "Organization", name: "Anthropic" },
          },
          {
            "@type": "EducationalOccupationalCredential",
            name: "Vibe Coding L5: Diamond",
            credentialCategory: "certification",
            recognizedBy: { "@type": "Organization", name: "Lovable" },
          },
        ],
        sameAs: [
          "https://fr.linkedin.com/in/quentin-duroy",
          "https://manga-ai.fr",
          "https://logiq-ia.fr",
          "https://github.com/exosuppra",
        ],
        address: {
          "@type": "PostalAddress",
          addressLocality: "Gréoux-les-Bains",
          addressRegion: "Provence-Alpes-Côte d'Azur",
          addressCountry: "FR",
        },
      })}
    />
  </head>
  <body class="min-h-screen overflow-x-hidden antialiased">
    <slot />
  </body>
</html>
