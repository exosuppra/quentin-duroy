---
const links = [
  { href: "#about", label: "À propos" },
  { href: "#parcours", label: "Parcours" },
  { href: "#competences", label: "Compétences" },
  { href: "#projets", label: "Projets" },
  { href: "#contact", label: "Contact" },
];
---

<header class="fixed inset-x-0 top-0 z-50 transition-all" id="site-header">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a
      href="#hero"
      class="group flex items-center gap-2 font-display text-sm font-semibold tracking-tight"
      id="hd-brand"
    >
      <span
        class="relative inline-flex h-7 w-7 items-center justify-center rounded-md text-xs font-bold text-white transition-transform group-hover:rotate-6"
        style="background: linear-gradient(135deg, #7c3aed 0%, #c026d3 50%, #dc2626 100%); box-shadow: 0 6px 18px -6px rgba(124,58,237,0.45);"
      >
        QD
      </span>
      <span class="hidden sm:inline">quentin-duroy.fr</span>
    </a>

    <nav class="hidden md:block">
      <ul
        class="flex items-center gap-1 rounded-full border px-2 py-1.5 backdrop-blur-md transition-colors"
        id="hd-nav"
      >
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="hd-link block rounded-full px-4 py-1.5 text-sm transition-colors"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href="#contact"
      class="hidden rounded-full px-4 py-2 text-sm font-medium text-white transition-all hover:-translate-y-0.5 sm:inline-block"
      style="background: linear-gradient(90deg, #7c3aed 0%, #c026d3 50%, #dc2626 100%); box-shadow: 0 8px 20px -8px rgba(124,58,237,0.4);"
    >
      Me contacter
    </a>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 32) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>

<style is:global>
  /* Default state: ON the cosmic hero — light text */
  #site-header #hd-brand { color: #ffffff; }
  #site-header #hd-nav {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.06);
  }
  #site-header .hd-link { color: rgba(255, 255, 255, 0.78); }
  #site-header .hd-link:hover {
    background: rgba(255, 255, 255, 0.10);
    color: #ffffff;
  }

  /* Scrolled state: past the hero — dark text on white blur */
  #site-header.scrolled {
    backdrop-filter: blur(16px);
    background-color: rgba(255, 255, 255, 0.80);
    border-bottom: 1px solid #e5e5e5;
  }
  #site-header.scrolled #hd-brand { color: #0a0a0a; }
  #site-header.scrolled #hd-nav {
    border-color: #e5e5e5;
    background: rgba(255, 255, 255, 0.65);
  }
  #site-header.scrolled .hd-link { color: #404040; }
  #site-header.scrolled .hd-link:hover {
    background: rgba(124, 58, 237, 0.10);
    color: #0a0a0a;
  }
</style>
