---
const links = [
  { href: "#about", label: "À propos" },
  { href: "#parcours", label: "Parcours" },
  { href: "#competences", label: "Compétences" },
  { href: "#projets", label: "Projets" },
  { href: "#contact", label: "Contact" },
];
---

<!--
  Site Header: hidden when on the hero (so the MinimalistHero in-section
  header serves as the brand). Slides down once user scrolls past 70vh.
-->
<header
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
  id="site-header"
  data-revealed="false"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <a
      href="#hero"
      class="group flex items-center gap-2 font-display text-sm font-semibold tracking-tight"
      style="color: #0a0a0a;"
    >
      <span
        class="relative inline-flex h-7 w-7 items-center justify-center rounded-md text-xs font-bold text-white transition-transform group-hover:rotate-6"
        style="background: linear-gradient(135deg, #7c3aed 0%, #c026d3 50%, #dc2626 100%); box-shadow: 0 6px 18px -6px rgba(124,58,237,0.45);"
      >
        QD
      </span>
      <span class="hidden sm:inline">quentin-duroy.fr</span>
    </a>

    <nav class="hidden md:block">
      <ul
        class="flex items-center gap-1 rounded-full border px-2 py-1.5 backdrop-blur-md"
        style="border-color: #e5e5e5; background: rgba(255,255,255,0.65);"
      >
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="block rounded-full px-4 py-1.5 text-sm transition-colors"
              style="color: #404040;"
              onmouseover="this.style.background='rgba(124,58,237,0.10)'; this.style.color='#0a0a0a'"
              onmouseout="this.style.background='transparent'; this.style.color='#404040'"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href="#contact"
      class="hidden rounded-full px-4 py-2 text-sm font-medium text-white transition-all hover:-translate-y-0.5 sm:inline-block"
      style="background: linear-gradient(90deg, #7c3aed 0%, #c026d3 50%, #dc2626 100%); box-shadow: 0 8px 20px -8px rgba(124,58,237,0.4);"
    >
      Me contacter
    </a>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => {
      const threshold = window.innerHeight * 0.7;
      const revealed = window.scrollY > threshold;
      header.dataset.revealed = revealed ? "true" : "false";
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>

<style is:global>
  /* Default: hidden (on the hero section, MinimalistHero owns the chrome) */
  #site-header {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }
  /* Revealed once scrolled past ~70vh */
  #site-header[data-revealed="true"] {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
    backdrop-filter: blur(16px);
    background-color: rgba(255, 255, 255, 0.85);
    border-bottom: 1px solid #e5e5e5;
  }
</style>
