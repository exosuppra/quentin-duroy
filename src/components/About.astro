---
const paragraphs = [
  "Installé à Saint-Martin-de-Brômes, entre les champs de lavande de Valensole et les gorges du Verdon, j'accompagne des entreprises dans leur transformation IA et leur présence en ligne. Mon approche combine ingénierie produit, intégration multi-modèles et automatisation des workflows métier.",
  "Diplômé de SUPDEWEB, j'ai forgé mon expertise sur des projets web complexes (SaaS, e-commerce, intranets) avant de me spécialiser dans l'IA générative et l'agentic automation. Aujourd'hui, je conçois et orchestre plus de 60 scénarios Make actifs en production — du SEO à la data en passant par les agents IA conversationnels.",
  "Je travaille en direct avec les fondateurs et les dirigeants, sans intermédiaire. Mes clients sont partout en France et à l'international : la Provence donne le rythme, le numérique abolit la distance.",
];
---

<section
  id="about"
  class="relative mx-auto max-w-6xl px-6 py-32 sm:py-40"
>
  <div class="grid gap-16 md:grid-cols-[1fr_2fr] md:gap-20">
    <div class="md:sticky md:top-32 md:self-start">
      <div
        class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium uppercase tracking-[0.2em]"
        style="border-color: rgba(139,92,246,0.25); background: rgba(139,92,246,0.06); color: #c4b5fd;"
      >
        À propos
      </div>
      <h2 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl" style="color: #fef3c7;">
        Construire des produits
        <span class="text-gradient">qui marchent.</span>
      </h2>
    </div>

    <div class="space-y-6 text-lg leading-relaxed" style="color: #e9d5b3;">
      {paragraphs.map((p) => <p>{p}</p>)}

      <div
        class="mt-10 grid grid-cols-2 gap-6 border-t pt-8 sm:grid-cols-4"
        style="border-color: rgba(255,255,255,0.08);"
      >
        <div>
          <div class="text-3xl font-bold" style="color: #fef3c7;">8+</div>
          <div class="mt-1 text-sm" style="color: #a8927a;">années web</div>
        </div>
        <div>
          <div class="text-3xl font-bold" style="color: #fef3c7;">60+</div>
          <div class="mt-1 text-sm" style="color: #a8927a;">scénarios Make actifs</div>
        </div>
        <div>
          <div class="text-3xl font-bold" style="color: #fef3c7;">240 p.</div>
          <div class="mt-1 text-sm" style="color: #a8927a;">manga généré par IA</div>
        </div>
        <div>
          <div class="text-3xl font-bold" style="color: #fef3c7;">FR/EN/ES</div>
          <div class="mt-1 text-sm" style="color: #a8927a;">trilingue</div>
        </div>
      </div>
    </div>
  </div>
</section>
