---
const groups = [
  {
    label: "IA générative",
    accent: "violet",
    items: [
      "Anthropic Claude",
      "OpenAI ChatGPT",
      "Google Gemini",
      "Stable Diffusion",
      "Suno (musique IA)",
      "Multi-modèles",
      "Prompt engineering",
    ],
  },
  {
    label: "Agents & IA-coding",
    accent: "red",
    items: [
      "Lovable",
      "Claude Code",
      "Claude Cowork",
      "MCP",
      "Agents IA sur mesure",
      "Tool use",
    ],
  },
  {
    label: "IA locale",
    accent: "violet",
    items: [
      "Ollama",
      "LM Studio",
      "Stable Diffusion local",
      "Modèles open-source",
      "Projets souverains",
    ],
  },
  {
    label: "Automation",
    accent: "red",
    items: ["Make.com", "n8n", "Zapier", "Microsoft Power Automate", "Webhooks", "60+ scénarios actifs"],
  },
  {
    label: "Front",
    accent: "violet",
    items: ["React", "Astro", "Vite", "TypeScript", "Tailwind", "Motion"],
  },
  {
    label: "Back",
    accent: "red",
    items: ["Node.js", "Supabase", "PostgreSQL", "Cloudflare Workers", "DataForSEO", "REST/GraphQL"],
  },
  {
    label: "DevOps",
    accent: "violet",
    items: ["Cloudflare Pages", "GitHub Actions", "Monitoring", "Edge functions"],
  },
  {
    label: "Conseil",
    accent: "red",
    items: ["Audit SEO technique", "Refonte perf", "Hardening sécurité", "Stratégie produit"],
  },
];

const accentMap = {
  violet:
    "border-color: rgba(124,58,237,0.32); background: rgba(124,58,237,0.06); color: #6d28d9;",
  red:
    "border-color: rgba(220,38,38,0.32); background: rgba(220,38,38,0.05); color: #b91c1c;",
} as const;
---

<section id="competences" class="relative overflow-hidden py-32 sm:py-40">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.18]"
    style="background-image: linear-gradient(to right, rgba(124,58,237,0.20) 1px, transparent 1px), linear-gradient(to bottom, rgba(220,38,38,0.16) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 top-1/4 -z-10 h-72 opacity-25"
    style="background: radial-gradient(ellipse at 30% 50%, #a78bfa 0%, transparent 60%), radial-gradient(ellipse at 70% 50%, #f87171 0%, transparent 60%); filter: blur(80px);"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-16 text-center">
      <div
        class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium uppercase tracking-[0.2em]"
        style="border-color: rgba(220,38,38,0.30); background: rgba(220,38,38,0.05); color: #b91c1c;"
      >
        Compétences
      </div>
      <h2
        class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl"
        style="color: #0a0a0a;"
      >
        Une stack <span class="text-gradient">polyvalente</span>,<br />
        de l'IA générative au déploiement edge.
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-base" style="color: #404040;">
        Je travaille avec l'écosystème <span style="color: #0a0a0a; font-weight: 600;">Anthropic</span>
        (Claude, Claude Code, Claude Cowork), <span style="color: #0a0a0a; font-weight: 600;">Lovable</span>,
        <span style="color: #0a0a0a; font-weight: 600;">Make</span> et de nombreux modèles d'IA hébergés
        en local. Spécialiste de l'agentique et de l'automatisation appliquées au terrain.
      </p>
    </div>

    <div class="space-y-8">
      {
        groups.map((group) => (
          <div
            class="flex flex-wrap items-center gap-3 border-t pt-6 first:border-0 first:pt-0"
            style="border-color: #e5e5e5;"
          >
            <div
              class="w-36 shrink-0 text-sm font-semibold uppercase tracking-wider"
              style="color: #737373;"
            >
              {group.label}
            </div>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span
                  class="inline-flex items-center rounded-full border px-4 py-1.5 text-sm font-medium backdrop-blur transition-all hover:-translate-y-0.5"
                  style={accentMap[group.accent as keyof typeof accentMap]}
                >
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
