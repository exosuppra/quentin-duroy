---
const groups = [
  {
    label: "Automation",
    accent: "ocre",
    items: ["Make.com", "n8n", "Zapier", "Microsoft Power Automate", "Agents IA", "60+ scénarios actifs"],
  },
  {
    label: "IA",
    accent: "lavande",
    items: ["OpenAI", "Anthropic", "Gemini", "Stable Diffusion", "Multi-modèles", "Prompt engineering"],
  },
  {
    label: "Front",
    accent: "terracotta",
    items: ["React", "Astro", "Vite", "TypeScript", "Tailwind", "Motion"],
  },
  {
    label: "Back",
    accent: "lavande",
    items: ["Node.js", "Supabase", "PostgreSQL", "Cloudflare Workers", "DataForSEO", "Make API"],
  },
  {
    label: "DevOps",
    accent: "ocre",
    items: ["Cloudflare Pages", "GitHub Actions", "Monitoring", "Edge functions"],
  },
  {
    label: "Conseil",
    accent: "terracotta",
    items: ["Audit SEO technique", "Refonte perf", "Hardening sécurité", "Stratégie produit"],
  },
];

const accentMap = {
  lavande:
    "border-style: solid; border-color: rgba(167,139,250,0.25); background: rgba(167,139,250,0.06); color: #c4b5fd;",
  terracotta:
    "border-style: solid; border-color: rgba(251,146,60,0.28); background: rgba(251,146,60,0.07); color: #fed7aa;",
  ocre:
    "border-style: solid; border-color: rgba(251,191,36,0.28); background: rgba(251,191,36,0.07); color: #fde68a;",
} as const;
---

<section id="competences" class="relative overflow-hidden py-32 sm:py-40">
  <!-- Garrigue grid background -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.12]"
    style="background-image: linear-gradient(to right, rgba(167,139,250,0.18) 1px, transparent 1px), linear-gradient(to bottom, rgba(217,119,6,0.14) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);"
  >
  </div>
  <!-- Sunset glow horizon -->
  <div
    class="pointer-events-none absolute inset-x-0 top-1/4 -z-10 h-72 opacity-40"
    style="background: radial-gradient(ellipse at 30% 50%, #7c3aed 0%, transparent 60%), radial-gradient(ellipse at 70% 50%, #c2410c 0%, transparent 60%), radial-gradient(ellipse at 50% 90%, #d97706 0%, transparent 60%); filter: blur(80px);"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-16 text-center">
      <div
        class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium uppercase tracking-[0.2em]"
        style="border-color: rgba(251,146,60,0.25); background: rgba(251,146,60,0.06); color: #fed7aa;"
      >
        Compétences
      </div>
      <h2 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl" style="color: #fef3c7;">
        Une stack <span class="text-gradient">moderne</span>,<br />
        au service du produit.
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-base" style="color: #e9d5b3;">
        Spécialité : orchestrer des scénarios <span style="color: #fde68a;">Make.com</span> et des agents IA pour
        livrer des produits qui tournent en production — sans usine à gaz.
      </p>
    </div>

    <div class="space-y-8">
      {
        groups.map((group) => (
          <div
            class="flex flex-wrap items-center gap-3 border-t pt-6 first:border-0 first:pt-0"
            style="border-color: rgba(255,255,255,0.06);"
          >
            <div
              class="w-28 shrink-0 text-sm font-semibold uppercase tracking-wider"
              style="color: #a8927a;"
            >
              {group.label}
            </div>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span
                  class="inline-flex items-center rounded-full border px-4 py-1.5 text-sm font-medium backdrop-blur transition-all hover:-translate-y-0.5"
                  style={accentMap[group.accent as keyof typeof accentMap]}
                >
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
