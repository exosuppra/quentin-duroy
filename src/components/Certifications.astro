---
const certs = [
  {
    name: "AI Fluency Framework & Foundations",
    issuer: "Anthropic",
    date: "Avril 2026",
    logo: "anthropic",
    accent: "terracotta",
    description: "Maîtrise de la pratique IA avec Claude : agents, MCP, tool use, prompt design.",
  },
  {
    name: "Vibe Coding · L5 Diamond",
    issuer: "Lovable",
    date: "Mars 2026",
    logo: "lovable",
    accent: "lavande",
    description: "Niveau Diamond, le plus haut grade en développement IA-assisté.",
  },
  {
    name: "Master 360° Digital, Computer Science",
    issuer: "SUPDEWEB",
    date: "2020 – 2022",
    logo: "supdeweb",
    accent: "ocre",
    description: "E-commerce, SEO/SEA avancé, programmatique, tracking, conception multimédia.",
  },
  {
    name: "Licence Gestion de Projet Digitale",
    issuer: "Aix-Marseille Université",
    date: "2019 – 2020",
    logo: "amu",
    accent: "lavande",
    description: "Mention 15,87/20. Management de projet, conception web, mesure d'efficacité.",
  },
];

const accentColor: Record<string, string> = {
  lavande: "#7c3aed",       // violet
  terracotta: "#dc2626",    // red
  ocre: "#c026d3",          // fuchsia midpoint
};
const accentBg: Record<string, string> = {
  lavande: "rgba(124,58,237,0.07)",
  terracotta: "rgba(220,38,38,0.06)",
  ocre: "rgba(192,38,211,0.06)",
};
const accentBorder: Record<string, string> = {
  lavande: "rgba(124,58,237,0.30)",
  terracotta: "rgba(220,38,38,0.30)",
  ocre: "rgba(192,38,211,0.28)",
};
---

<section
  id="certifications"
  class="relative overflow-hidden py-32 sm:py-40"
>
  <!-- Soft sun glow background -->
  <div
    aria-hidden
    class="pointer-events-none absolute inset-x-0 top-1/3 -z-10 h-72 opacity-25"
    style="background: radial-gradient(ellipse at 30% 50%, #a78bfa 0%, transparent 60%), radial-gradient(ellipse at 70% 50%, #f87171 0%, transparent 60%); filter: blur(80px);"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-16 text-center">
      <div
        class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium uppercase tracking-[0.2em]"
        style="border-color: rgba(220,38,38,0.30); background: rgba(220,38,38,0.05); color: #b91c1c;"
      >
        Certifications
      </div>
      <h2 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl" style="color: #0a0a0a;">
        Une <span class="text-gradient">expertise</span> reconnue.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base" style="color: #404040;">
        Anthropic, Lovable, SUPDEWEB, Aix-Marseille : quatre tampons qui
        attestent que la pratique suit la théorie.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        certs.map((c, i) => (
          <article
            class="group relative flex flex-col rounded-2xl border p-6 transition-all hover:-translate-y-1"
            style={`border-color: #e5e5e5; background: rgba(255,255,255,0.70); box-shadow: 0 6px 18px -10px #e5e5e5; animation: float ${5 + (i % 3)}s ease-in-out infinite; animation-delay: ${i * 200}ms;`}
            onmouseover={`this.style.borderColor='${accentBorder[c.accent]}'; this.style.boxShadow='0 14px 30px -12px ${accentColor[c.accent]}40'`}
            onmouseout={`this.style.borderColor='#e5e5e5'; this.style.boxShadow='0 6px 18px -10px #e5e5e5'`}
          >
            {/* Badge */}
            <div class="mb-4 flex items-center justify-between">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-xl text-lg font-bold"
                style={`background: ${accentBg[c.accent]}; color: ${accentColor[c.accent]}; border: 1px solid ${accentBorder[c.accent]};`}
              >
                {c.issuer.slice(0, 1)}
              </div>
              <span
                class="rounded-full border px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider"
                style={`border-color: ${accentBorder[c.accent]}; background: ${accentBg[c.accent]}; color: ${accentColor[c.accent]};`}
              >
                {c.date}
              </span>
            </div>

            <h3 class="text-base font-bold leading-tight" style="color: #0a0a0a;">
              {c.name}
            </h3>
            <p
              class="mt-1 text-sm font-medium"
              style={`color: ${accentColor[c.accent]};`}
            >
              {c.issuer}
            </p>
            <p class="mt-3 flex-1 text-sm leading-relaxed" style="color: #404040;">
              {c.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
