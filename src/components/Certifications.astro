---
// 16 vraies certifications (LinkedIn de Quentin)
const microCerts = [
  // Anthropic (13)
  { issuer: "Anthropic", name: "Claude with Google Vertex AI", date: "Mai 2026", id: "ysu55ztdurks", accent: "violet" },
  { issuer: "Anthropic", name: "AI Capabilities and Limitations", date: "Mai 2026", id: "j8ysbjw5dd8g", accent: "violet" },
  { issuer: "Anthropic", name: "AI Fluency for Small Businesses", date: "Mai 2026", id: "q5d2vwu84d7x", accent: "violet" },
  { issuer: "Anthropic", name: "AI Fluency for Nonprofits", date: "Mai 2026", id: "opc2uv5vob3z", accent: "violet" },
  { issuer: "Anthropic", name: "Teaching AI Fluency", date: "Mai 2026", id: "gcfyxozv82xt", accent: "violet" },
  { issuer: "Anthropic", name: "AI Fluency for Students", date: "Mai 2026", id: "kdjbjav8jgfj", accent: "violet" },
  { issuer: "Anthropic", name: "AI Fluency for Educators", date: "Mai 2026", id: "atfkq3jf86du", accent: "violet" },
  { issuer: "Anthropic", name: "Introduction to Model Context Protocol", date: "Mai 2026", id: "5gip3bw9d9pa", accent: "violet" },
  { issuer: "Anthropic", name: "Building with the Claude API", date: "Mai 2026", id: "noebcq8pwgvm", accent: "violet" },
  { issuer: "Anthropic", name: "AI Fluency Framework & Foundations", date: "Avr. 2026", id: "nb9knnyqtjvo", accent: "violet" },
  { issuer: "Anthropic", name: "Claude Code in Action", date: "Avr. 2026", id: "xxi68usz8mb6", accent: "violet" },
  { issuer: "Anthropic", name: "Introduction to Claude Cowork", date: "Avr. 2026", id: "6naec5chjo9v", accent: "violet" },
  { issuer: "Anthropic", name: "Claude Code 101", date: "Avr. 2026", id: "eop32xy8tq2s", accent: "violet" },
  { issuer: "Anthropic", name: "Claude 101", date: "Avr. 2026", id: "8czgacbz8svh", accent: "violet" },
  // Make (1)
  { issuer: "Make", name: "Make Foundation", date: "Nov. 2025", id: null, accent: "red" },
  // Lovable (1)
  { issuer: "Lovable", name: "Vibe Coding L5 Diamond", date: "Mars 2026", id: null, accent: "fuchsia" },
];

const diplomas = [
  {
    name: "Master 360° Digital, Computer Science",
    issuer: "SUPDEWEB",
    date: "2020 – 2022",
    description: "E-commerce, SEO/SEA avancé, programmatique, tracking, conception multimédia.",
    accent: "violet",
  },
  {
    name: "Licence Gestion de Projet Digital",
    issuer: "Aix-Marseille Université",
    date: "2019 – 2020",
    description: "Management de projet, conception web, mesure d'efficacité des solutions digitales.",
    accent: "red",
  },
];

const accentColor: Record<string, string> = {
  violet: "#7c3aed",
  red: "#dc2626",
  fuchsia: "#c026d3",
};
const accentBg: Record<string, string> = {
  violet: "rgba(124,58,237,0.07)",
  red: "rgba(220,38,38,0.06)",
  fuchsia: "rgba(192,38,211,0.06)",
};
const accentBorder: Record<string, string> = {
  violet: "rgba(124,58,237,0.30)",
  red: "rgba(220,38,38,0.30)",
  fuchsia: "rgba(192,38,211,0.28)",
};

// Count by issuer
const countAnthropic = microCerts.filter(c => c.issuer === "Anthropic").length;
const countMake = microCerts.filter(c => c.issuer === "Make").length;
const countLovable = microCerts.filter(c => c.issuer === "Lovable").length;
---

<section id="certifications" class="relative overflow-hidden py-32 sm:py-40">
  <div
    aria-hidden
    class="pointer-events-none absolute inset-x-0 top-1/3 -z-10 h-72 opacity-25"
    style="background: radial-gradient(ellipse at 30% 50%, #a78bfa 0%, transparent 60%), radial-gradient(ellipse at 70% 50%, #f87171 0%, transparent 60%); filter: blur(80px);"
  >
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <!-- HEADER -->
    <div class="mb-16 text-center">
      <div
        class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium uppercase tracking-[0.2em]"
        style="border-color: rgba(220,38,38,0.30); background: rgba(220,38,38,0.05); color: #b91c1c;"
      >
        Expertise reconnue
      </div>
      <h2 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl" style="color: #0a0a0a;">
        16 certifications,<br />
        <span class="text-gradient">3 reconnaissances officielles</span>.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base" style="color: #404040;">
        Vainqueur d'un concours international Make, statut National Treasure
        chez Lovable (top 1 % France), webinaire FROT record YouTube. {countAnthropic}
        certifications Anthropic, {countMake} Make Academy, {countLovable} Lovable.
      </p>
    </div>

    <!-- 1. RECONNAISSANCES OFFICIELLES — 3 cards -->
    <div class="mb-20 grid gap-5 md:grid-cols-3">
      <!-- MAKE GRID CONTEST -->
      <article
        class="group relative flex flex-col overflow-hidden rounded-2xl border p-6"
        style="border-color: rgba(220,38,38,0.30); background: linear-gradient(135deg, rgba(220,38,38,0.06) 0%, rgba(255,255,255,0.92) 100%); box-shadow: 0 10px 28px -14px rgba(220,38,38,0.30);"
      >
        <div class="mb-3 flex items-start justify-between">
          <span class="text-4xl">🏆</span>
          <span
            class="rounded-full border px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider"
            style="border-color: rgba(220,38,38,0.30); background: rgba(255,255,255,0.92); color: #b91c1c;"
          >
            Juillet 2025
          </span>
        </div>
        <h3 class="text-lg font-bold leading-tight" style="color: #0a0a0a;">
          Lauréat international<br />Concours Make Grid
        </h3>
        <p class="mt-1 text-sm font-medium" style="color: #b91c1c;">
          Make.com · concours international
        </p>
        <p class="mt-3 flex-1 text-sm leading-relaxed" style="color: #404040;">
          Vainqueur d'un concours international Make sur la promotion de Make Grid.
          Reconnaissance officielle de Make sur LinkedIn.
        </p>
        <a
          href="https://www.linkedin.com/posts/quentin-duroy_withmake-makegrid-automation-share-7379485307169214465-atgZ"
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold transition-colors hover:underline"
          style="color: #b91c1c;"
        >
          Voir le post LinkedIn
          <svg viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3" aria-hidden>
            <path d="M5.5 3a.5.5 0 010-1h7a.5.5 0 01.5.5v7a.5.5 0 01-1 0V3.707l-8.146 8.147a.5.5 0 01-.708-.708L11.293 3H5.5z"/>
          </svg>
        </a>
      </article>

      <!-- LOVABLE NATIONAL TREASURE -->
      <article
        class="group relative flex flex-col overflow-hidden rounded-2xl border p-6"
        style="border-color: rgba(192,38,211,0.30); background: linear-gradient(135deg, rgba(192,38,211,0.06) 0%, rgba(255,255,255,0.92) 100%); box-shadow: 0 10px 28px -14px rgba(192,38,211,0.30);"
      >
        <div class="mb-3 flex items-start justify-between">
          <span class="text-4xl">🇫🇷</span>
          <span
            class="rounded-full border px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider"
            style="border-color: rgba(192,38,211,0.30); background: rgba(255,255,255,0.92); color: #a21caf;"
          >
            2025
          </span>
        </div>
        <h3 class="text-lg font-bold leading-tight" style="color: #0a0a0a;">
          National Treasure<br />Top 1 % France
        </h3>
        <p class="mt-1 text-sm font-medium" style="color: #a21caf;">
          Lovable · reconnaissance officielle
        </p>
        <p class="mt-3 flex-1 text-sm leading-relaxed" style="color: #404040;">
          Classé parmi les top créateurs Lovable en France par trafic, apps dans le
          top 1 % des visites depuis la France.
        </p>
        <div class="mt-4 grid grid-cols-2 gap-2">
          <picture>
            <source srcSet="/lovable-big-deal.webp" type="image/webp" />
            <img
              src="/lovable-big-deal.png"
              alt="Lovable · You're kind of a big deal in France (top 1%)"
              loading="lazy"
              class="aspect-square w-full rounded-lg border object-cover"
              style="border-color: rgba(192,38,211,0.30);"
            />
          </picture>
          <picture>
            <source srcSet="/lovable-national-treasure.webp" type="image/webp" />
            <img
              src="/lovable-national-treasure.png"
              alt="Lovable · National Treasure"
              loading="lazy"
              class="aspect-square w-full rounded-lg border object-cover"
              style="border-color: rgba(192,38,211,0.30);"
            />
          </picture>
        </div>
      </article>

      <!-- WEBINAIRE FROT -->
      <article
        class="group relative flex flex-col overflow-hidden rounded-2xl border p-6"
        style="border-color: rgba(124,58,237,0.30); background: linear-gradient(135deg, rgba(124,58,237,0.06) 0%, rgba(255,255,255,0.92) 100%); box-shadow: 0 10px 28px -14px rgba(124,58,237,0.30);"
      >
        <div class="mb-3 flex items-start justify-between">
          <span class="text-4xl">🎙️</span>
          <span
            class="rounded-full border px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider"
            style="border-color: rgba(124,58,237,0.30); background: rgba(255,255,255,0.92); color: #6d28d9;"
          >
            13 nov. 2025
          </span>
        </div>
        <h3 class="text-lg font-bold leading-tight" style="color: #0a0a0a;">
          Webinaire FROT PACA<br />« Œil de l'expert »
        </h3>
        <p class="mt-1 text-sm font-medium" style="color: #6d28d9;">
          Fédération Régionale des OT PACA
        </p>
        <p class="mt-3 flex-1 text-sm leading-relaxed" style="color: #404040;">
          130 spectateurs en direct, 4,8/5 de satisfaction, plus de 300 replays
          YouTube — record de la chaîne FROT.
        </p>
        <a
          href="https://www.linkedin.com/posts/vous-avez-manqu%C3%A9-notre-webinaire-lhomme-share-7400074220581498880-DO3y"
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold transition-colors hover:underline"
          style="color: #6d28d9;"
        >
          Voir le post LinkedIn FROT
          <svg viewBox="0 0 16 16" fill="currentColor" class="h-3 w-3" aria-hidden>
            <path d="M5.5 3a.5.5 0 010-1h7a.5.5 0 01.5.5v7a.5.5 0 01-1 0V3.707l-8.146 8.147a.5.5 0 01-.708-.708L11.293 3H5.5z"/>
          </svg>
        </a>
      </article>
    </div>

    <!-- 2. REPLAY YOUTUBE -->
    <div class="mb-20">
      <div class="mb-6 flex items-end justify-between">
        <div>
          <h3 class="text-2xl font-bold tracking-tight" style="color: #0a0a0a;">
            Le webinaire en replay
          </h3>
          <p class="mt-1 text-sm" style="color: #737373;">
            « Moins de clic, plus de café » · 13 nov. 2025 · FROT PACA
          </p>
        </div>
      </div>
      <div
        class="overflow-hidden rounded-2xl border bg-black shadow-xl"
        style="border-color: #e5e5e5; aspect-ratio: 16/9;"
      >
        <iframe
          src="https://www.youtube.com/embed/ntirnVcj9ko"
          title="L'Œil de l'Expert · Moins de clic, plus de café"
          class="h-full w-full"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      <p class="mt-4 text-center text-sm italic" style="color: #737373;">
        À noter : depuis novembre 2025, énormément d'évolutions ont été
        apportées à mes projets, agents IA et workflows. Le replay reste un
        bon point d'entrée mais le terrain a beaucoup avancé.
      </p>
    </div>

    <!-- 3. 16 MICRO-CERTIFICATIONS -->
    <div class="mb-16">
      <div class="mb-6 flex items-end justify-between">
        <div>
          <h3 class="text-2xl font-bold tracking-tight" style="color: #0a0a0a;">
            16 certifications
          </h3>
          <p class="mt-1 text-sm" style="color: #737373;">
            Anthropic · Make Academy · Lovable
          </p>
        </div>
        <div class="hidden text-right text-xs sm:block" style="color: #737373;">
          <div><span class="font-bold" style="color: #7c3aed;">{countAnthropic}</span> Anthropic</div>
          <div><span class="font-bold" style="color: #dc2626;">{countMake}</span> Make Academy</div>
          <div><span class="font-bold" style="color: #c026d3;">{countLovable}</span> Lovable</div>
        </div>
      </div>
      <div class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3">
        {
          microCerts.map((c) => (
            <div
              class="group flex items-center gap-3 rounded-xl border bg-white p-3 transition-all hover:-translate-y-0.5"
              style="border-color: #e5e5e5;"
              onmouseover={`this.style.borderColor='${accentBorder[c.accent]}'`}
              onmouseout={`this.style.borderColor='#e5e5e5'`}
            >
              <div
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-xs font-bold"
                style={`background: ${accentBg[c.accent]}; color: ${accentColor[c.accent]}; border: 1px solid ${accentBorder[c.accent]};`}
              >
                {c.issuer.slice(0, 1)}
              </div>
              <div class="min-w-0 flex-1">
                <div class="truncate text-sm font-semibold" style="color: #0a0a0a;">
                  {c.name}
                </div>
                <div class="text-xs" style="color: #737373;">
                  {c.issuer} · {c.date}
                  {c.id && <span class="ml-1 opacity-60">· {c.id}</span>}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- 4. DIPLÔMES (style formel séparé) -->
    <div>
      <h3 class="mb-6 text-sm font-semibold uppercase tracking-[0.2em]" style="color: #737373;">
        Diplômes universitaires
      </h3>
      <div class="grid gap-4 md:grid-cols-2">
        {
          diplomas.map((d) => (
            <article class="rounded-2xl border bg-white p-6" style="border-color: #e5e5e5;">
              <div class="mb-3 flex items-center justify-between">
                <span
                  class="rounded-full border px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider"
                  style={`border-color: ${accentBorder[d.accent]}; background: ${accentBg[d.accent]}; color: ${accentColor[d.accent]};`}
                >
                  {d.date}
                </span>
              </div>
              <h4 class="text-base font-bold leading-tight" style="color: #0a0a0a;">
                {d.name}
              </h4>
              <p class="mt-1 text-sm font-medium" style={`color: ${accentColor[d.accent]};`}>
                {d.issuer}
              </p>
              <p class="mt-3 text-sm leading-relaxed" style="color: #404040;">
                {d.description}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
